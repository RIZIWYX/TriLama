# --- Boîte universitaire (IMAP) ---
IMAP_HOST=imap.univ-rouen.fr
IMAP_PORT=993
IMAP_USER=identifiant-ent
IMAP_PASSWORD=change-moi
IMAP_INBOX=INBOX
# true = déplace aussi le mail dans FOLDER_PARENT (en plus de l'étiquette)
MOVE_TO_FOLDER=true
# Dossier où ranger les réponses de candidature
FOLDER_PARENT=Candidatures stage

# --- Envoi du récapitulatif (SMTP) ---
SMTP_HOST=smtp.univ-rouen.fr
SMTP_PORT=465
SMTP_USER=identifiant-ent
SMTP_PASSWORD=change-moi
NOTIFY_TO=prenom.nom@univ-rouen.fr

# --- IA ---
OLLAMA_MODEL=qwen2.5:3b
# Intervalle entre deux vérifications (secondes)
POLL_SECONDS=300
# Heure d'envoi du récap quotidien (0-23, heure de Paris)
RECAP_HOUR=20
TZ=Europe/Paris
# true = classe sans déplacer (pour tester)
DRY_RUN=true

# --- Détecteur de phishing (optionnel, projet phishdetect) ---
# Active le service phishdetect de docker-compose.yml
COMPOSE_PROFILES=phishing
# Dossier du projet phishdetect (modèle entraîné dans models/)
PHISHDETECT_DIR=../phishdetect
# Laisser vide pour désactiver la vérification
PHISHDETECT_URL=http://phishdetect:8000
